<?xml version="1.0" encoding="UTF-8"?>
<sumoConfiguration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">

    <input>
        <net-file value="osm.net.xml.gz"/>
        <route-files value="osm.passenger.trips.xml"/>
        <additional-files value="combined_additional.xml"/>
    </input>

    <time>
        <begin value="23000"/>
        <step-length value="1"/>  <!-- Standard beibehalten -->
    </time>

    <processing>
        <ignore-route-errors value="true"/>
        <tls.actuated.jam-threshold value="30"/>
        <lateral-resolution value="1.6"/>  <!-- WENIGER GENAU = SCHNELLER -->
        <collision.action value="none"/>   <!-- KOLLISIONSERKENNUNG AUS = SCHNELLER -->
        <max-depart-delay value="900"/>
        
        <!-- NUR NÖTIGE DEVICES -->
        <device.battery.probability value="1"/>
        <device.battery.explicit value="veh_ev"/>
        
        <!-- REROUTING REDUZIEREN -->
        <device.rerouting.probability value="1.0"/>  <!-- Nur 50% der Fahrzeuge -->
        <device.rerouting.explicit value="veh_ev"/>
        
        <!-- STATIONFINDER OPTIMIEREN -->
        <device.stationfinder.probability value="1"/>
        <device.stationfinder.explicit value="veh_ev"/>
        <device.stationfinder.rescueTime value="3600"/>      <!-- Weniger häufig suchen -->
        <device.stationfinder.reserveFactor value="1.1"/>    <!-- Kleinerer Puffer -->
        <device.stationfinder.radius value="3000"/>          <!-- Kleinerer Suchradius -->
    </processing>

    <routing>
        <device.rerouting.adaptation-steps value="36"/>      <!-- Weniger Updates -->
        <device.rerouting.adaptation-interval value="30"/>   <!-- Längere Intervalle -->
        <device.rerouting.pre-period value="120"/>           <!-- Längere Vorlaufzeit -->
        <device.rerouting.with-taz value="false"/>           <!-- AUS für Performance -->
    </routing>

    <report>
        <verbose value="false"/>                    <!-- WENIGER OUTPUT -->
        <duration-log.statistics value="false"/>    <!-- AUS -->
        <no-step-log value="true"/>
        <no-warnings value="true"/>                 <!-- WENIGER OUTPUT -->
    </report>

</sumoConfiguration>