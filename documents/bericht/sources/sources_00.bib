@article{codeca_saga_2022,
	title = {{SAGA}: {An} {Activity}-based {Multi}-modal {Mobility} {ScenarioGenerator} for {SUMO}},
	volume = {1},
	copyright = {https://creativecommons.org/licenses/by/3.0/de/deed.en},
	issn = {2750-4425},
	shorttitle = {{SAGA}},
	url = {https://www.tib-op.org/ojs/index.php/scp/article/view/99},
	doi = {10.52825/scp.v1i.99},
	abstract = {In this paper, we deﬁne a workﬂow and a toolchain to support fast mobility scenario prototyping based on open data and open-source software. SAGA is an activity-based multi-modal mobility scenario generator for the Simulation of Urban MObiltiy (SUMO). Starting from an OpenStreetMap (OSM) ﬁle, SAGA extracts the data required to build a multi-modal scenario, and in a step-by-step fashion, generates the conﬁgurations needed to execute it, including the intermediate steps required to reﬁne the scenario with additional data, allowing the iterative improvement of realism and representativeness.},
	language = {en},
	urldate = {2025-07-30},
	journal = {SUMO Conference Proceedings},
	author = {Codeca, Lara and {Jakob Erdmann} and {Vinny Cahill} and {Jerome Haerri}},
	month = jun,
	year = {2022},
	pages = {39--58},
	file = {PDF:files/21/Codeca et al. - 2022 - SAGA An Activity-based Multi-modal Mobility ScenarioGenerator for SUMO.pdf:application/pdf},
}


